{
  "name": "@jky/api",
  "version": "1.0.0",
  "private": true,
  "description": "JKY-Radar REST API (Express + MongoDB).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/scripts/seed-demo.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@jky/radar-adapters": "1.0.0",
    "@jky/radar-core": "1.0.0",
    "@jky/shared": "1.0.0",
    "@node-rs/argon2": "^2.0.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.16.0",
    "multer": "^2.0.1",
    "pdfkit": "^0.17.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsup": "^8.5.0"
  }
}
