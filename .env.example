# JKY-Radar environment template. Copy to .env and adjust. These are NOT real secrets.
NODE_ENV=development
PORT=4000
# Local MongoDB or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/jky_radar
# Used to derive CSRF/HMAC material. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Exact browser origin of the web app (used for CORS + Origin checks)
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
# Upload and analysis limits
MAX_SPEC_BYTES=2097152
ANALYSIS_TIMEOUT_MS=20000
# worker = isolated worker thread with memory limits (recommended), inline = same thread (tests/dev)
ANALYSIS_ISOLATION=worker
# Remote URL import is not implemented; keep false.
ENABLE_REMOTE_URL_IMPORT=false
# Seed the public read-only demo workspace at API start (idempotent)
DEMO_SEED_ENABLED=true
# Serve the built web app from the API (same-origin deployment, recommended)
SERVE_WEB=false
