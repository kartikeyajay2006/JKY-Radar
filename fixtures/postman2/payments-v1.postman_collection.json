{
  "info": {
    "_postman_id": "8f6d3c1e-0b1d-4d6e-9a33-1c8b2f7a9e10",
    "name": "PayFlow Payments (synthetic)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "sk_test_51HfakeSyntheticKeyForDemo00", "type": "string" }]
  },
  "item": [
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1999,\n  \"currency\": \"EUR\",\n  \"source\": \"tok_visa\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));"] } }
          ]
        },
        {
          "name": "List payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments?page_size={{pageSize}}&status=succeeded",
              "host": ["{{baseUrl}}"],
              "path": ["payments"],
              "query": [
                { "key": "page_size", "value": "{{pageSize}}" },
                { "key": "status", "value": "succeeded" }
              ]
            }
          }
        },
        {
          "name": "Refund payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJkZW1vIn0.c2lnbmF0dXJlLWZha2U" }],
            "url": { "raw": "{{baseUrl}}/payments/:paymentId/refunds", "host": ["{{baseUrl}}"], "path": ["payments", ":paymentId", "refunds"] }
          }
        }
      ]
    }
  ]
}
