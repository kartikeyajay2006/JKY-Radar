{
  "name": "jky-radar",
  "version": "1.0.0",
  "private": true,
  "description": "JKY-Radar \u2014 vendor-neutral API contract compatibility intelligence. One Radar. Every API. Know What Breaks Before You Ship.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/radar-core",
    "packages/radar-adapters",
    "packages/radar-cli",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @jky/api\" \"npm run dev -w @jky/web\"",
    "build": "npm run build -w @jky/web",
    "start": "npm run start -w @jky/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project packages",
    "test:api": "vitest run --project api",
    "test:e2e": "playwright test",
    "seed:demo": "npm run seed:demo -w @jky/api",
    "radar": "node packages/radar-cli/src/cli.js",
    "docs:matrix": "node scripts/generate-support-matrix.js",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.15.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
